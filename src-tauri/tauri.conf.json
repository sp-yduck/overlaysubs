{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OverlaySubs",
  "identifier": "io.github.overlaysubs",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      { "label": "main", "create": false, "title": "OverlaySubs", "url": "index.html", "width": 980, "height": 680, "minWidth": 760, "minHeight": 520 },
      {
        "label": "overlay", "create": false, "title": "OverlaySubs overlay", "url": "overlay.html",
        "width": 1100, "height": 220, "y": 760, "center": true,
        "transparent": true, "decorations": false, "alwaysOnTop": true, "visibleOnAllWorkspaces": true,
        "skipTaskbar": true, "shadow": false, "focus": false, "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "license": "MIT",
    "copyright": "OverlaySubs contributors. Built with PLaMo.",
    "publisher": "OverlaySubs contributors",
    "shortDescription": "Real-time transcription and translation of PC audio with subtitle overlay",
    "longDescription": "OverlaySubs transcribes and translates any audio playing on your PC in real time and shows it as a subtitle overlay. No API key is required: audio and text are processed locally and never sent anywhere. It works offline once the models are downloaded.",
    "category": "Utility",
    "windows": { "nsis": { "installMode": "currentUser" } },
    "macOS": { "minimumSystemVersion": "13.0" }
  }
}
