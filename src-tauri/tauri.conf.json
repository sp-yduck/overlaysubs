{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OverlaySubs",
  "version": "0.2.1",
  "identifier": "io.github.overlaysubs",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      { "label": "main", "title": "OverlaySubs", "url": "index.html", "width": 980, "height": 680, "minWidth": 760, "minHeight": 520 },
      {
        "label": "overlay", "title": "OverlaySubs overlay", "url": "overlay.html",
        "width": 1100, "height": 220, "y": 760, "center": true,
        "transparent": true, "decorations": false, "alwaysOnTop": true, "visibleOnAllWorkspaces": true,
        "skipTaskbar": true, "shadow": false, "focus": false, "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "license": "MIT",
    "copyright": "OverlaySubs contributors. Built with PLaMo.",
    "publisher": "OverlaySubs contributors",
    "shortDescription": "PCの音声をリアルタイムで文字起こし・翻訳するデスクトップ字幕アプリ",
    "longDescription": "PC上で再生されるあらゆる音声をリアルタイムで文字起こし・翻訳し、字幕としてオーバーレイ表示するデスクトップアプリです。\nAPIキー不要で、音声やテキストが外部に送信されることはありません。モデルをダウンロードした後はオフラインでも動作します。",
    "category": "Utility",
    "windows": { "nsis": { "installMode": "currentUser" } },
    "macOS": { "minimumSystemVersion": "13.0" }
  }
}
